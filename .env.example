# Leave empty in development: the Vite dev server proxies /api to http://localhost:5000
# Set it when the API is on another origin (the backend CLIENT_ORIGIN must then match this site's origin):
# VITE_API_URL=https://api.example.com/api/v1
VITE_API_URL=
# Dev proxy target (only used by `npm run dev`)
# VITE_PROXY_TARGET=http://localhost:5000
